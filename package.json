{
  "name": "inkdrop-model",
  "version": "3.0.1",
  "description": "Data model for Inkdrop",
  "scripts": {
    "build": "npm-run-all build:schema build:lib doc",
    "build:lib": "rm -rf lib && tsdown",
    "build:schema": "./compile_schema.sh",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "vitest --run",
    "doc": "./generate_doc.sh",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm-run-all build:* typecheck lint test"
  },
  "author": "Takuya Matsuyama <t@inkdrop.app>",
  "license": "MIT",
  "packageManager": "pnpm@11.28.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/inkdropapp/inkdrop-model.git"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "nanoid": "^6.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tsdown": "0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "ajv": "^8.20.0"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    }
  },
  "types": "lib/index.d.ts",
  "main": "lib/index.js",
  "unpkg": "lib/index.umd.js",
  "module": "lib/index.esm.js",
  "browser": "lib/index.browser.js",
  "react-native": "lib/index.browser.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./lib/index.browser.js",
      "browser": "./lib/index.browser.js",
      "module": "./lib/index.esm.js",
      "default": "./lib/index.js"
    },
    "./validators": {
      "types": "./lib/validators.d.ts",
      "react-native": "./lib/validators.browser.js",
      "browser": "./lib/validators.browser.js",
      "module": "./lib/validators.esm.js",
      "default": "./lib/validators.js"
    },
    "./json-schema/*.json": "./json-schema/*.json",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "keywords": [
    "json-schema"
  ],
  "files": [
    "lib",
    "json-schema/*.json",
    "ajv-validators",
    "validators/package.json"
  ]
}
